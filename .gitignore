*.json
!requirements.txt

# 日志
*.log
*.log.*

# 备份 / 调试残留
*.bak
*.bak*
*.bak_*
*.py.bak*

# Python
__pycache__/
*.pyc
*.egg-info/

# 虚拟环境 / 依赖
venv/
.venv/

# 缩略图缓存
cache/

# 系统
.DS_Store
Thumbs.db

# 本地示例照片（用户自己照片，不入库）
photos/
